	(text_box "IC1 AD7124-8 (LFCSP-32 5 × 5 mm, boîtier CP-32-12) : ADC sigma-delta 24 bits avec PGA, référence interne, sources de courant d'excitation programmables et interface SPI.\nIl numérise les tensions des voies NTC (page 5) et dialogue avec l'hôte par le connecteur (page 7)."
		(exclude_from_sim no)
		(at 270.51 45.72 0)
		(size 102.87 11.8)
		(margins 1.3525 1.3525 1.3525 1.3525)
		(stroke
			(width -0.0001)
			(type solid)
		)
		(fill
			(type color)
			(color 230 243 245 1)
		)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "d2f18f1a-46fd-4228-88f4-e23d06efc06f")
	)
	(text_box "DESIGN NOTE · CONFIGURATION À DÉFINIR"
		(exclude_from_sim no)
		(at 270.51 58.79 0)
