				(face "Arial")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "0bed1f69-dc56-4f96-9b57-4d327d351d2c")
	)
	(text_box "Zone réservée aux test points. Les pastilles GND des trous peuvent servir de point de masse pour la sonde."
