	(property "RELEASE_BODY_UNRELEASED" "___________________________________\n\nAdded\n\n-   KiCad 10 project from the OPEN_PHASE / OPEN_WEIGHT template\n\n-   Sheets: AD7124-8 ADC, NTC inputs, power, connectors, holes\n\n-   Doc sheets: block diagram, architecture, sequencing, revisions\n\n-   4x M3 mounting holes H1-H4 to GND\n\n-   JLCPCB 4-layer rules and stackup, self-contained lib/\n\n-   CI: KiBot, DRAFT variant")
	(property "RELEASE_DATE" "24-Oct-2026")
